      "id": "song-ravana-tandavam",
      "title": "Ravana Tandavam",
      "artist": "A.R. Rahman, G. V. Prakash Kumar, Anirudh Ravichander",
      "album": "Ramayana",
      "genre": "Devotional",
      "year": 2026,
      "duration": 194,
      "audioUrl": "https://pub-e756afa74cc047fcaa33b6d2ced3fa04.r2.dev/songs/Ravana%20Tandavam.mp3",
      "thumbnailUrl": "https://pub-e756afa74cc047fcaa33b6d2ced3fa04.r2.dev/thumbnalis/ramayana%20new%20poster.jpg",
      "description": "Ravana Tandavam from Ramayana composed by A.R. Rahman",
      "language": "Tamil",
      "isExplicit": false,
      "lyrics": [
        {
          "time": 0,
          "text": "🔥 [Intro - War Drums & Conches]"
        },
        {
          "time": 4,
          "text": "Hey Om, Hey Om... Hey Hey Om, Hey Om..."
        },
        {
          "time": 15,
          "text": "Jatatavigalajjala Pravahapavitasthale"
        },
        {
          "time": 22,
          "text": "Galevalambya Lambitam Bhujangatungamalikam"
        },
        {
          "time": 30,
          "text": "Damaddamaddamaddama Ninadavaddamarvayam"
        },
        {
          "time": 37,
          "text": "Chakara Chandatandavam Tanotu Nah Shivah Shivam"
        },
        {
          "time": 45,
          "text": "🔱 Shiva...!"
        },
        {
          "time": 52,
          "text": "Gharar Gharar Jharar Samar Asur Pasar Jai Jai!"
        },
        {
          "time": 60,
          "text": "Chalat Hilat Karak Khilat Vikat Milat Jai Jai!"
        },
        {
          "time": 68,
          "text": "Shakra Vijita, Shakra Vijita, Shakra Vijita, Jai Jai!"
        },
        {
          "time": 76,
          "text": "Darsha Darsha Ravana Darsha!"
        },
        {
          "time": 84,
          "text": "Ra Ra Ra Ravana... Ra Ra Ra Ravana..."
        },
        {
          "time": 100,
          "text": "Ravana... Ravana... Ravana..."
        },
        {
          "time": 108,
          "text": "Dainyam Varsham Ravana"
        },
        {
          "time": 115,
          "text": "Jagatam Jagatam Bhramsham"
        },
        {
          "time": 128,
          "text": "⚡ [Fierce Tandavam Beats & War Chorus]"
        },
        {
          "time": 150,
          "text": "Gharar Gharar Jharar Samar Asur Pasar Jai Jai!"
        },
        {
          "time": 164,
          "text": "Shakra Vijita, Shakra Vijita, Jai Jai! Ravana!"
        },
        {
          "time": 180,
          "text": "⚡ [Grand Orchestral Climax]"
        }
      ]
    },
    {
      "id": "song-anthaathi",
      "title": "Anthaathi",
      "artist": "Govind Vasantha, Chinmayi Sripaada, Bhadra Rajin, M. Nassar",
      "album": "96",
      "genre": "Melody",
      "year": 2018,
      "duration": 434,
      "audioUrl": "https://pub-e756afa74cc047fcaa33b6d2ced3fa04.r2.dev/songs/Anthaathi-MassTamilan.com.mp3",
      "thumbnailUrl": "https://pub-e756afa74cc047fcaa33b6d2ced3fa04.r2.dev/thumbnalis/96-Original-Motion-Picture-Soundtrack-Tamil-2018-20250905072505-500x500.webp",
      "description": "Anthaathi from 96 composed by Govind Vasantha",
      "language": "Tamil",
      "isExplicit": false,
      "lyrics": [
        {
          "time": 0,
          "text": "🎵 [Intro - Ambient Drone]"
        },
        {
          "time": 6.5,
          "text": "Peranbe... Kadhal..."
        },
        {
          "time": 17.5,
          "text": "Ulnokki aadugindra aadal sathaa... Aaraadha aaval..."
        },
        {
          "time": 32.5,
          "text": "Yethetho saayal yetru thiriyum kadhal... Prathyega thedal..."
        },
        {
          "time": 47.5,
          "text": "Theeyil theeraatha kaatril... Pul poondil puzhuvil ulathil ilathil..."
        },
        {
          "time": 62.5,
          "text": "Thaane ellaamum aagi naam kaanum aruvame... Ithyaathi kadhal..."
        },
        {
          "time": 74.5,
          "text": "Illaatha pothum thedum thedal sathaa... Maaraadhu kadhal..."
        },
        {
          "time": 84.5,
          "text": "Mandraadum pothum maattru karuthil modhum maalaatha oodal..."
        },
        {
          "time": 92.5,
          "text": "Naam intha theeyil veedu kattum theekuchchi!"
        },
        {
          "time": 100.5,
          "text": "Naam intha kaatril oonjal kattum thoosi!"
        },
        {
          "time": 107.5,
          "text": "Naam intha neeril vaazhkai oattum neer poochchi!"
        },
        {
          "time": 114.5,
          "text": "Naam intha kaambil kaamathin rusi..."
        },
        {
          "time": 122.5,
          "text": "Kadhal kanneeril silanthi... Kadhal vinmeenin meganthi..."
        },
        {
          "time": 130.5,
          "text": "Kadhal meiyaana vathanthi... Kaalanthorum thodarum diary..."
        },
        {
          "time": 137.5,
          "text": "Kadhal deiveega ethiri... Kadhal saaththaanin visiri..."
        },
        {
          "time": 144.5,
          "text": "Kadhal aanmaavin pulari... Vaazhnthu petra degree..."
        },
        {
          "time": 152.5,
          "text": "Oar... vidaikulle... Vinaavellaam... pathunguthey aaa..."
        },
        {
          "time": 167.5,
          "text": "Naan... karainthathey... marainthathey... mudinthathey aaa..."
        },
        {
          "time": 180.5,
          "text": "🎻 (Melodic Strings Interlude)"
        },
        {
          "time": 198.5,
          "text": "Konjum pooraname vaa... nee... Konjum ezhilisaye..."
        },
        {
          "time": 208.5,
          "text": "Panja varna bootham nenjam niraiyuthey... Kaanbathellaam kadhaladi..."
        },
        {
          "time": 218.5,
          "text": "Kadhale kadhale... thaniperunthunaiye..."
        },
        {
          "time": 228.5,
          "text": "Kooda vaa kooda vaa... pothum pothum..."
        },
        {
          "time": 237.5,
          "text": "Kadhale kadhale... vaazhvin neelam..."
        },
        {
          "time": 247.5,
          "text": "Pogalaam poga vaa... nee..."
        },
        {
          "time": 258.5,
          "text": "Aaa... Thigampari... Valampuri... Suyambu nee..."
        },
        {
          "time": 268.5,
          "text": "Aaa... Prahaaram nee... Prabaavam nee... Pravaaham nee..."
        },
        {
          "time": 278.5,
          "text": "Aaa... Srungaaram nee... Aangaaram nee... Oangaaram nee..."
        },
        {
          "time": 288.5,
          "text": "Nee... Anthaathi nee... Anthaathi nee... Anthaathi nee..."
        },
        {
          "time": 307.5,
          "text": "🎻 (Govind Vasantha Signature Violin Solo)"
        },
        {
          "time": 392.5,
          "text": "📜 [Dialogue - Theda vendam mun arivi...]"
        },
        {
          "time": 422.5,
          "text": "✨ (Instrumental Outro)"
        }
      ]
    },
